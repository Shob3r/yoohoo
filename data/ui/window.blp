using Gtk 4.0;

template $MyAppWindow: Gtk.ApplicationWindow {
    title: _("Elysiae");
    default-width: 600;
    default-height: 400;

    Gtk.Box {
        orientation: vertical;

        Gtk.HeaderBar {}

        Gtk.Box {
            orientation: vertical;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;
            vexpand: true;
            halign: center;
            valign: center;

            Gtk.Label label_widget {
                label: _("Hello");
            }

            Gtk.Button {
                label: _("Click me");
                clicked => $on_button_clicked();
            }
        }
    }
}
